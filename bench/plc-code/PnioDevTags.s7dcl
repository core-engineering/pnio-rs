// devIn_Real10     Real        %ID40
// devIn_Real11     Real        %ID44
// devIn_Real12     Real        %ID48
// devIn_Real13     Real        %ID52
// devIn_Real14     Real        %ID56
// devIn_Real15     Real        %ID60
// devIn_Bits0      Byte        %IB64      in2 BOOL 0..7 (LSB-first)
// devIn_Bits1      Byte        %IB65      in2 BOOL 8..15
// devIn_Bits2      Byte        %IB66      in2 BOOL 16..23
// devIn_Bits3      Byte        %IB67      in2 BOOL 24..31
// devOut_Echo*     DWord       %QD0       OB30 echo of devIn_Counter (out3 REAL 0)
// devOut_Ob30*     DWord       %QD4       OB30 execution counter (out3 REAL 1)
