// OB30 — latency echo for the pnio device (bench §6h).
// Create a Cyclic interrupt OB (30) in TIA with a 5000 µs cycle, then paste this body
// (or import as external source and set the event class to Cyclic interrupt, 5 ms).
// REQUIRED: assign the four pnio-dev modules to process image partition TPA 1
// (module properties > I/O addresses > Process image: TPA 1) and attach TPA 1 to this
// OB with automatic update — inputs are then refreshed at the start of every call and
// outputs shipped at its end. That is exactly what this experiment measures.
ORGANIZATION_BLOCK "OB30_LatencyEcho"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
    // Echo the edge's cycle counter back, raw 32-bit copy (device slot 1 -> slot 3).
    "devOut_Echo" := "devIn_Counter";
    // Publish our own execution counter so the edge can see OB30's cadence on the wire.
    "BenchData".Ob30Count := "BenchData".Ob30Count + 1;
    "devOut_Ob30" := DINT_TO_DWORD("BenchData".Ob30Count);
END_ORGANIZATION_BLOCK
