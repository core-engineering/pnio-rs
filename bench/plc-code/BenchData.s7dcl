// BenchData — global test DB for the pnio robustness campaign (bench §6h).
// Import: TIA > External source files > add > generate blocks.
DATA_BLOCK "BenchData"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR
    Cycle     : DInt;            // OB1 pass counter
    Gen       : DWord;           // OB1-generated value (round-trip check)
    Errors    : DInt;            // OB1 round trips that came back wrong
    Checks    : DInt;            // OB1 round trips verified
    LoadIter  : DInt := 20000;   // OB1 artificial load: iterations per pass (0 = no load)
    Acc       : Real;            // scratch sink so the load loop cannot be optimized away
    Ob30Count : DInt;            // OB30 executions, published to the device in %QD4
END_VAR
BEGIN
END_DATA_BLOCK
